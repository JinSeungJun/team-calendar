rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 일정: 팀 코드를 아는 사람만 (팀 목록 조회는 불가)
    match /teams/{team}/events/{eventId} {
      allow read, delete: if request.auth != null && team.size() >= 16;
      allow create, update: if request.auth != null && team.size() >= 16
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.start is string
        && request.resource.data.end is string
        && request.resource.data.end >= request.resource.data.start
        && request.resource.data.memo.size() <= 1000;
    }

    // 팀 설정 (담당자·구분 목록)
    match /teams/{team}/meta/{docId} {
      allow read, write: if request.auth != null && team.size() >= 16;
    }
  }
}
